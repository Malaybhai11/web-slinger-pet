{
  "name": "web-slinger-pet",
  "version": "2.0.0",
  "description": "A DOM-aware pixel Spider-Man who lives on your page: patrols your nav, hops between buttons, web-swings to your cards, and has opinions about your copy.",
  "type": "module",
  "scripts": {
    "dev": "npm run sprites && tsc -p tsconfig.json && node server.mjs",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "preview": "node server.mjs",
    "sprites": "node tools/build-atlas.mjs",
    "qa": "node qa/shoot.mjs",
    "pixellab": "node tools/pixellab.mjs",
    "poses": "node qa/poses.mjs"
  },
  "keywords": [
    "pixel-art",
    "canvas",
    "dom-aware",
    "web-pet",
    "desktop-pet",
    "spiderman",
    "sprite-animation",
    "typescript",
    "zero-dependencies"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2",
    "playwright": "^1.49.0"
  }
}
